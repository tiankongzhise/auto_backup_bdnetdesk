APP_ENV=development
LOG_LEVEL=INFO

LOCAL_DATA_DIR=./var/data
LOCAL_SQLITE_PATH=./var/data/backup_state.sqlite3
LOCAL_CACHE_DIR=./var/cache

CLOUD_API_BASE_URL=http://127.0.0.1:8080
# 可选：运行时覆盖当前设备 token。留空时客户端会自动注册当前设备，并将 token 保存到本机 DPAPI 凭据文件。
CLOUD_API_DEVICE_TOKEN=

BAIDU_TOKEN_ENCRYPTION_METHOD=password_argon2id_aes256gcm_v1
BAIDU_RSA_PRIVATE_KEY_PATH=

# 可选：覆盖本机 Device Token 和百度 password KDF 材料的凭据存储路径。
AUTO_BACKUP_DEVICE_CREDENTIAL_STORE_PATH=
AUTO_BACKUP_BAIDU_KDF_STORE_PATH=

SECRETS_STORAGE=windows-dpapi
